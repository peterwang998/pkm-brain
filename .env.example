# Local workspace
BRAIN_HOME=~/brain

# Default LLM provider. `codex` uses the signed-in Codex CLI; API keys are
# only needed when selecting direct API providers such as openai or anthropic.
PKM_BRAIN_LLM_PROVIDER=codex

# Optional role-specific overrides. Roles: extractor, resolver, gardener,
# synthesizer, critic, auditor.
# PKM_BRAIN_LLM_EXTRACTOR_PROVIDER=codex
# PKM_BRAIN_LLM_EXTRACTOR_MODEL=gpt-5.6-luna
# PKM_BRAIN_LLM_EXTRACTOR_REASONING_EFFORT=low
# PKM_BRAIN_LLM_GARDENER_PROVIDER=codex
# PKM_BRAIN_LLM_GARDENER_MODEL=gpt-5.6-luna
# PKM_BRAIN_LLM_GARDENER_REASONING_EFFORT=medium
# PKM_BRAIN_LLM_CRITIC_PROVIDER=codex
# PKM_BRAIN_LLM_CRITIC_MODEL=gpt-5.6-luna
# PKM_BRAIN_LLM_CRITIC_REASONING_EFFORT=medium
# PKM_BRAIN_LLM_AUDITOR_PROVIDER=codex
# PKM_BRAIN_LLM_AUDITOR_MODEL=gpt-5.6-sol
# PKM_BRAIN_LLM_AUDITOR_REASONING_EFFORT=xhigh

# Provider-specific model knobs.
# PKM_BRAIN_CODEX_MODEL=gpt-5.6-sol
# PKM_BRAIN_CODEX_MODEL_FALLBACKS=gpt-5.6-luna
# PKM_BRAIN_CODEX_REASONING_EFFORT=medium
# PKM_BRAIN_OPENAI_MODEL=gpt-5.5
# PKM_BRAIN_ANTHROPIC_MODEL=claude-sonnet-4-5

# API provider credentials. Leave blank for local Codex/Ollama use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings. Hash is dependency-free; sentence-transformer requires
# `uv sync --extra embeddings` and an explicit vector rebuild.
PKM_BRAIN_EMBEDDING_PROVIDER=hash
# PKM_BRAIN_EMBEDDING_PROVIDER=sentence-transformer
# PKM_BRAIN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# PKM_BRAIN_EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
